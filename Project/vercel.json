{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,public/**}"
    },
    "server.js": {
      "includeFiles": "{index.html,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/config.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/config",
      "destination": "/api/index.js"
    },
    {
      "source": "/livez",
      "destination": "/api/index.js"
    },
    {
      "source": "/readyz",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|health|config|livez|readyz|index\\.html)[^.]*)",
      "destination": "/index.html"
    }
  ]
}
